---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import TextmodeLayout from "@/layouts/TextmodeLayout.astro";
import VolumeScreen from "@/features/volumes/components/VolumeScreen.astro";
import { getAllVolumes } from "@/features/volumes/server";
import { volumeListLabel, volumeTitle } from "@/features/volumes";

export const getStaticPaths = (async () => {
  const volumes = await getAllVolumes();
  return volumes.map((volume) => ({
    params: { volume: String(volume.number) },
    props: { volume }
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { volume } = Astro.props;

const hasCjk = volume.philes.some((phile) => phile.data.lang === "zh" || /[\p{Script=Han}]/u.test(phile.data.title));
---

<TextmodeLayout title={volumeTitle(volume)} description={volumeListLabel(volume)} preloadCjk={hasCjk}>
  <VolumeScreen volume={volume} />
</TextmodeLayout>

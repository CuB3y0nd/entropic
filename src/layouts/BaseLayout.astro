---
import Analytics from "@vercel/analytics/astro";
import "@/styles/global.css";
import { config, siteConfig } from "@/config/server";
import { appearanceConfig, effectsConfig, textmodeConfig } from "@/config/server";
import { twitterCardText } from "@/features/seo";
import { appearanceCssVariables } from "@/shared/textmode/core/css-vars";

import type { PageProps } from "./types";

type Props = PageProps;

const pageTitle = Astro.props.title ? `${Astro.props.title} :: ${siteConfig.name}` : siteConfig.name;
const tabTitle = Astro.props.tabTitle ?? siteConfig.name;
const description = Astro.props.description?.trim() || siteConfig.description;
const pageLang = Astro.props.lang ?? "en";
const preloadCjk = Astro.props.preloadCjk ?? false;
const pageType = Astro.props.pageType ?? "website";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const rssUrl = new URL("/rss.xml", Astro.site ?? Astro.url).toString();
const socialImage = siteConfig.socialImage;
const socialImageUrl = socialImage ? new URL(socialImage.src, Astro.site ?? Astro.url).toString() : undefined;
const appearanceCss = appearanceCssVariables(appearanceConfig);
const mobileFitBreakpoint = textmodeConfig.mobileFitBreakpoint;
const particlesEnabled = effectsConfig.particles.enabled;
---

<!doctype html>
<html lang={pageLang} prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={appearanceConfig.colors.link} />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={rssUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={pageLang === "zh" ? "zh_CN" : "en_US"} />
    {
      socialImage && (
        <>
          <meta property="og:image" content={socialImageUrl} />
          {socialImage.type && <meta property="og:image:type" content={socialImage.type} />}
          <meta property="og:image:width" content={String(socialImage.width)} />
          <meta property="og:image:height" content={String(socialImage.height)} />
          <meta property="og:image:alt" content={socialImage.alt} />
          <meta name="twitter:image" content={socialImageUrl} />
          <meta name="twitter:image:alt" content={socialImage.alt} />
        </>
      )
    }
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={twitterCardText(pageTitle, "title")} />
    <meta name="twitter:description" content={twitterCardText(description, "description")} />
    {
      pageType === "article" && Astro.props.publishedTime && (
        <meta property="article:published_time" content={Astro.props.publishedTime.toISOString()} />
      )
    }
    <style set:html={appearanceCss}></style>
    <link
      rel="preload"
      href={appearanceConfig.fonts.asciiUrl}
      as="font"
      type={`font/${appearanceConfig.fonts.asciiFormat}`}
      crossorigin
    />
    {preloadCjk && <link rel="preload" href="/assets/cjk/wqy-cjk-body.png" as="image" />}
    {preloadCjk && <link rel="preload" href="/assets/cjk/wqy-cjk-link.png" as="image" />}
    <title>{tabTitle}</title>
  </head>
  <body
    class="font-textmode text-foreground"
    data-mobile-fit-breakpoint={mobileFitBreakpoint}
    data-particles-enabled={particlesEnabled}
    data-particle-config={particlesEnabled ? JSON.stringify(effectsConfig.particles) : undefined}
  >
    <slot />
    {config.analytics && <Analytics />}
    <script>
      import { installTextmodeBootstrap } from "@/shared/textmode/client";

      installTextmodeBootstrap();
    </script>
  </body>
</html>

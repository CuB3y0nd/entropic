{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "astro.config.ts",
      "entropic.config.ts",
      "biome.json",
      "package.json",
      "tsconfig.json",
      ".prettierrc.json",
      "src/**/*.{css,js,json,ts}",
      "scripts/**/*.{mjs,ts}",
      "tests/**/*.{mjs,ts}"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}

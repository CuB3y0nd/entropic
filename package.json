{
  "name": "entropic",
  "version": "0.1.0",
  "private": true,
  "description": "A retro textmode blog theme for purists.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "check": "pnpm check:config && pnpm check:types && biome check . && pnpm check:astro && pnpm check:boundaries",
    "format": "biome format --write . && prettier --write \"src/**/*.astro\"",
    "lint": "biome lint .",
    "test:browser": "node tests/browser/run.mjs",
    "test:wkd": "node --import tsx --test tests/wkd/*.test.mjs",
    "assets:fonts": "pnpm fonts:subset && pnpm fonts:atlas",
    "fonts:atlas": "node scripts/fonts/build-cjk-atlas.mjs",
    "fonts:subset": "node scripts/fonts/subset-fonts.mjs",
    "check:astro": "prettier --check \"src/**/*.astro\"",
    "check:boundaries": "node scripts/checks/boundaries.mjs",
    "test": "node --import tsx --test tests/*/*.test.ts tests/*/*.test.mjs",
    "check:types": "astro check && tsc --noEmit",
    "check:config": "node --import tsx scripts/checks/configuration.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.1",
    "entities": "^8.0.0",
    "openpgp": "^6.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.4.0",
    "@biomejs/biome": "^2.5.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}

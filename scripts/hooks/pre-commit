#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
tsx="$script_dir/../../node_modules/.bin/tsx"
if [[ ! -x "$tsx" ]]; then
  printf '%s\n' 'pre-commit: run pnpm install --frozen-lockfile before checking redacted philes.' >&2
  exit 1
fi
exec "$tsx" "$script_dir/../content/check-redacted.ts"

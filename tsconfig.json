{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "entropic.config.ts",
    "src/**/*",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", ".tmp", "docs"]
}
